---
// src/components/Navbar.astro
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services' },
  { name: 'Projects', href: '/projects' },
  { name: 'About', href: '/about' },
  { name: 'Contact', href: '/contact' }
];
---

<header id="nav-wrapper" class="fixed top-0 left-0 w-full z-50 px-0 transition-none pointer-events-none">
  <div
    id="nav-shell"
    class="pointer-events-auto mx-auto w-full bg-white/80 backdrop-blur-xl border-b border-black/[0.06] transition-shadow"
  >
    <div class="max-w-7xl mx-auto px-5 sm:px-8 h-16 flex items-center justify-between">
      <!-- Brand -->
      <a href="/" class="nav-brand flex items-center gap-2.5 group">
        <div class="w-9 h-9 rounded-xl bg-[#1D1D1F] flex items-center justify-center text-white font-bold text-xs tracking-tighter group-hover:bg-[#0066CC] transition-colors shadow-sm">
          CRD
        </div>
        <div class="leading-none">
          <span class="font-semibold text-[15px] tracking-tight text-[#1D1D1F] block">CRD Infratech</span>
          <span class="text-[10px] font-medium text-[#6E6E73] block mt-0.5">Geomatics & UAV</span>
        </div>
      </a>

      <!-- Desktop Navigation (Strict Page Routes) -->
      <nav class="hidden md:flex items-center gap-1 bg-[#F5F5F7]/90 p-1 rounded-full border border-black/[0.05]">
        {navLinks.map((link) => {
          const isActive = pathname === link.href;
          return (
            <a
              href={link.href}
              class={`nav-link relative px-4 py-1.5 rounded-full text-xs font-medium transition-colors duration-200 ${
                isActive
                  ? 'bg-white text-[#0066CC] font-semibold shadow-sm'
                  : 'text-[#1D1D1F]/75 hover:text-[#1D1D1F]'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- Desktop CTA -->
      <div class="hidden md:flex items-center">
        <a
          href="/contact"
          class="nav-cta px-4 py-2 rounded-full text-xs font-semibold bg-[#0066CC] hover:bg-[#0055B3] text-white transition-all shadow-sm shadow-[#0066CC]/20"
        >
          Book Survey
        </a>
      </div>

      <!-- Unique Mobile Menu Button (4-Node Geospatial Survey Grid -> Crosshair X) -->
      <button
        id="mobile-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        class="md:hidden relative w-10 h-10 rounded-xl bg-[#F5F5F7] hover:bg-[#E8E8ED] border border-black/[0.06] flex items-center justify-center text-[#1D1D1F] active:scale-95 transition-transform"
      >
        <div id="grid-icon" class="relative w-4 h-4">
          <span class="geo-dot dot-tl absolute top-0 left-0 w-1.5 h-1.5 rounded-[2px] bg-[#1D1D1F]"></span>
          <span class="geo-dot dot-tr absolute top-0 right-0 w-1.5 h-1.5 rounded-[2px] bg-[#0066CC]"></span>
          <span class="geo-dot dot-bl absolute bottom-0 left-0 w-1.5 h-1.5 rounded-[2px] bg-[#0066CC]"></span>
          <span class="geo-dot dot-br absolute bottom-0 right-0 w-1.5 h-1.5 rounded-[2px] bg-[#1D1D1F]"></span>
          <!-- Crosshair bars revealed on open -->
          <span class="cross-bar bar-1 absolute top-1/2 left-0 w-full h-[1.8px] bg-[#1D1D1F] rounded-full -translate-y-1/2 scale-x-0"></span>
          <span class="cross-bar bar-2 absolute top-1/2 left-0 w-full h-[1.8px] bg-[#1D1D1F] rounded-full -translate-y-1/2 scale-x-0"></span>
        </div>
      </button>
    </div>
  </div>

  <!-- GSAP Animated Mobile Drawer -->
  <div
    id="mobile-drawer"
    class="pointer-events-auto md:hidden mx-4 mt-2 rounded-3xl bg-white/95 backdrop-blur-2xl border border-black/[0.08] shadow-2xl shadow-black/10 overflow-hidden hidden"
  >
    <div class="p-5 space-y-1.5">
      <div class="px-3 pb-2 text-[10px] font-mono uppercase tracking-widest text-[#6E6E73] border-b border-black/[0.05]">
        Navigation
      </div>
      {navLinks.map((link, idx) => {
        const isActive = pathname === link.href;
        return (
          <a
            href={link.href}
            class={`drawer-item flex items-center justify-between px-3.5 py-3 rounded-2xl text-sm font-medium transition-colors ${
              isActive
                ? 'bg-[#0066CC]/10 text-[#0066CC] font-semibold'
                : 'text-[#1D1D1F] hover:bg-[#F5F5F7]'
            }`}
          >
            <span>{link.name}</span>
            <span class="text-[10px] font-mono text-[#6E6E73]">0{idx + 1}</span>
          </a>
        );
      })}
      <div class="pt-3 drawer-item">
        <a
          href="/contact"
          class="block w-full text-center py-3 rounded-2xl text-xs font-semibold uppercase tracking-wider bg-[#0066CC] hover:bg-[#0055B3] text-white shadow-sm"
        >
          Book a Site Survey
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  import { gsap } from 'gsap';

  const initNavbar = () => {
    const wrapper = document.getElementById('nav-wrapper');
    const shell = document.getElementById('nav-shell');
    const toggleBtn = document.getElementById('mobile-toggle');
    const drawer = document.getElementById('mobile-drawer');

    if (!wrapper || !shell) return;

    // 1. Staggered Entrance Animation
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
    tl.from('.nav-brand', { x: -18, opacity: 0, duration: 0.6, clearProps: 'transform,opacity' })
      .from('.nav-link', { y: -12, opacity: 0, stagger: 0.06, duration: 0.5, clearProps: 'transform,opacity' }, '-=0.35')
      .from('.nav-cta', { scale: 0.9, opacity: 0, duration: 0.45, clearProps: 'transform,opacity' }, '-=0.3');

    // 2. GSAP Scroll Morph: Full-Width Bar -> Floating Apple-Style Pill
    let isFloating = false;
    const handleScroll = () => {
      const scrolled = window.scrollY > 40;
      if (scrolled && !isFloating) {
        isFloating = true;
        gsap.to(wrapper, { paddingTop: 12, paddingLeft: 16, paddingRight: 16, duration: 0.4, ease: 'power3.out' });
        gsap.to(shell, {
          maxWidth: '64rem',
          borderRadius: 9999,
          boxShadow: '0 12px 32px rgba(0, 0, 0, 0.08)',
          duration: 0.4,
          ease: 'power3.out'
        });
      } else if (!scrolled && isFloating) {
        isFloating = false;
        gsap.to(wrapper, { paddingTop: 0, paddingLeft: 0, paddingRight: 0, duration: 0.35, ease: 'power3.out' });
        gsap.to(shell, {
          maxWidth: '100%',
          borderRadius: 0,
          boxShadow: '0 0px 0px rgba(0, 0, 0, 0)',
          duration: 0.35,
          ease: 'power3.out'
        });
      }
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // 3. Unique Mobile Icon + Drawer GSAP Toggle
    let isOpen = false;
    toggleBtn?.addEventListener('click', () => {
      isOpen = !isOpen;
      toggleBtn.setAttribute('aria-expanded', String(isOpen));

      if (isOpen && drawer) {
        drawer.classList.remove('hidden');

        // Morph 4-node grid into rotated X crosshair
        gsap.to('#grid-icon', { rotation: 90, duration: 0.4, ease: 'back.out(1.7)' });
        gsap.to('.geo-dot', { scale: 0, opacity: 0, duration: 0.2, stagger: 0.03 });
        gsap.to('.bar-1', { scaleX: 1, rotation: 45, duration: 0.35, delay: 0.1, ease: 'power3.out' });
        gsap.to('.bar-2', { scaleX: 1, rotation: -45, duration: 0.35, delay: 0.1, ease: 'power3.out' });

        // Animate drawer & stagger links
        gsap.fromTo(
          drawer,
          { opacity: 0, y: -14, scale: 0.97 },
          { opacity: 1, y: 0, scale: 1, duration: 0.35, ease: 'power3.out' }
        );
        gsap.fromTo(
          '.drawer-item',
          { x: -12, opacity: 0 },
          { x: 0, opacity: 1, stagger: 0.05, duration: 0.3, delay: 0.08, ease: 'power2.out' }
        );
      } else if (drawer) {
        // Morph X back to 4-node geospatial grid
        gsap.to('#grid-icon', { rotation: 0, duration: 0.4, ease: 'power3.out' });
        gsap.to('.bar-1, .bar-2', { scaleX: 0, rotation: 0, duration: 0.2 });
        gsap.to('.geo-dot', { scale: 1, opacity: 1, duration: 0.3, delay: 0.12, stagger: 0.03, ease: 'back.out(2)' });

        gsap.to(drawer, {
          opacity: 0,
          y: -10,
          scale: 0.98,
          duration: 0.25,
          ease: 'power2.in',
          onComplete: () => drawer.classList.add('hidden')
        });
      }
    });
  };

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initNavbar();
  } else {
    document.addEventListener('DOMContentLoaded', initNavbar);
  }
</script>