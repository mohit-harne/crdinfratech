---
// src/components/ThreeGeoBackground.astro
---
<div class="fixed inset-0 w-full h-full pointer-events-none z-0 overflow-hidden bg-[#F5F5F7]">
  <canvas id="geo-bg" class="w-full h-full block"></canvas>
</div>

<script>
  import * as THREE from 'three';

  const initGeo3D = () => {
    const canvas = document.getElementById('geo-bg') as HTMLCanvasElement | null;
    if (!canvas) return;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0xf5f5f7);
    scene.fog = new THREE.FogExp2(0xf5f5f7, 0.0028);

    const camera = new THREE.PerspectiveCamera(
      50,
      window.innerWidth / window.innerHeight,
      0.5,
      900
    );
    camera.position.set(0, 42, 105);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);

    // 1. Topographic Elevation Mesh (High-Visibility Light Theme)
    const planeGeo = new THREE.PlaneGeometry(340, 340, 68, 68);
    planeGeo.rotateX(-Math.PI / 2);

    const pos = planeGeo.attributes.position;
    const colors = new Float32Array(pos.count * 3);
    const cLow = new THREE.Color(0x64748b);  // Slate-500
    const cMid = new THREE.Color(0x0284c7);  // Sky-600
    const cHigh = new THREE.Color(0x4338ca); // Indigo-700

    for (let i = 0; i < pos.count; i++) {
      const x = pos.getX(i);
      const z = pos.getZ(i);
      const y =
        Math.sin(x * 0.032) * Math.cos(z * 0.032) * 14 +
        Math.sin(x * 0.015 + z * 0.012) * 12;
      pos.setY(i, y);

      const t = THREE.MathUtils.clamp((y + 18) / 36, 0, 1);
      const col = new THREE.Color();
      if (t < 0.5) col.lerpColors(cLow, cMid, t * 2);
      else col.lerpColors(cMid, cHigh, (t - 0.5) * 2);

      colors[i * 3] = col.r;
      colors[i * 3 + 1] = col.g;
      colors[i * 3 + 2] = col.b;
    }
    planeGeo.setAttribute('color', new THREE.BufferAttribute(colors, 3));

    const wireMat = new THREE.MeshBasicMaterial({
      vertexColors: true,
      wireframe: true,
      transparent: true,
      opacity: 0.42,
    });
    const terrain = new THREE.Mesh(planeGeo, wireMat);
    scene.add(terrain);

    // 2. LiDAR Point Cloud
    const pointMat = new THREE.PointsMaterial({
      vertexColors: true,
      size: 2.2,
      transparent: true,
      opacity: 0.85,
    });
    const points = new THREE.Points(planeGeo, pointMat);
    scene.add(points);

    // 3. Laser Scan Line
    const scanGeo = new THREE.PlaneGeometry(340, 2.5);
    scanGeo.rotateX(-Math.PI / 2);
    const scanMat = new THREE.MeshBasicMaterial({
      color: 0x0066cc,
      transparent: true,
      opacity: 0.55,
      side: THREE.DoubleSide,
    });
    const scanLine = new THREE.Mesh(scanGeo, scanMat);
    scanLine.position.y = 16;
    scene.add(scanLine);

    let mouseX = 0;
    let mouseY = 0;
    let scrollY = 0;

    window.addEventListener('mousemove', (e) => {
      mouseX = (e.clientX / window.innerWidth - 0.5) * 20;
      mouseY = (e.clientY / window.innerHeight - 0.5) * 14;
    });

    window.addEventListener(
      'scroll',
      () => {
        scrollY = window.scrollY;
      },
      { passive: true }
    );

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    const clock = new THREE.Clock();
    const animate = () => {
      requestAnimationFrame(animate);
      const t = clock.getElapsedTime();

      terrain.rotation.y = t * 0.015;
      points.rotation.y = t * 0.015;
      scanLine.rotation.y = t * 0.015;
      scanLine.position.z = Math.sin(t * 0.65) * 115;

      const targetZ = Math.max(55, 105 - scrollY * 0.05);
      camera.position.x += (mouseX - camera.position.x) * 0.04;
      camera.position.y += (42 - mouseY - camera.position.y) * 0.04;
      camera.position.z += (targetZ - camera.position.z) * 0.05;
      camera.lookAt(0, 0, 0);

      renderer.render(scene, camera);
    };
    animate();
  };

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initGeo3D();
  } else {
    document.addEventListener('DOMContentLoaded', initGeo3D);
  }
</script>