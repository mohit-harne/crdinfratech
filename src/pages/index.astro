---
import Layout from '../layouts/Layout.astro';

const surveyCategories = [
  {
    category: 'Aerial Remote Sensing',
    title: 'Drone LiDAR & Photogrammetry',
    desc: 'High-density point clouds penetrating dense forest canopy for highways, solar parks, and mining volumetrics.',
    spec: 'GSD ≤ 1.2 cm/px',
    img: 'https://images.unsplash.com/photo-1508614589041-895b88991e3e?auto=format&fit=crop&w=900&q=80'
  },
  {
    category: 'Ground Geodesy',
    title: 'DGPS / RTK Control Networks',
    desc: 'Primary geodetic benchmarks tied to national Survey of India datum (WGS84 / UTM) via dual-frequency GNSS.',
    spec: '±1.2 cm RMS',
    img: 'https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=900&q=80'
  },
  {
    category: 'Linear Infrastructure',
    title: 'Highway & Rail Corridor Topo',
    desc: 'Strip plans, L-sections, cross-sections, and bridge centerlines engineered to NHAI, MoRTH, and IRC standards.',
    spec: 'UAV + Total Station',
    img: 'https://images.unsplash.com/photo-1541888946425-d0fbb1861564?auto=format&fit=crop&w=900&q=80'
  },
  {
    category: 'Subsurface Geophysics',
    title: 'Underground Utility (GPR)',
    desc: 'Ground Penetrating Radar detecting buried pipelines, live cables, and bedrock profiles before excavation.',
    spec: 'Up to 6m Depth',
    img: 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=900&q=80'
  },
  {
    category: 'Hydrographic & Marine',
    title: 'Bathymetric & River Surveys',
    desc: 'Echo-sounder hydrography integrated with RTK for reservoir siltation, river cross-sections, and flood models.',
    spec: 'Sonar + RTK',
    img: 'https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&w=900&q=80'
  },
  {
    category: 'Structural & Mining',
    title: 'Terrestrial 3D SLAM & BIM',
    desc: 'Millimeter-accurate 3D digital twins of tunnels, bridges, heritage structures, and dam deflection audits.',
    spec: 'BIM / As-Built',
    img: 'https://images.unsplash.com/photo-1590496793929-36417d3117de?auto=format&fit=crop&w=900&q=80'
  }
];

const deliverables = [
  {
    title: '3D Photogrammetric Mesh',
    format: '.OBJ · .FBX · Cesium 3D Tiles',
    desc: 'Photorealistic, georeferenced 3D surface models for virtual site inspections and stakeholder flythroughs.',
    poster: 'https://images.unsplash.com/photo-1524661135-423995f22d0b?auto=format&fit=crop&w=800&q=80',
    video: 'https://assets.mixkit.co/videos/preview/mixkit-drone-flying-over-a-bridge-under-construction-42790-large.mp4'
  },
  {
    title: 'True Orthomosaic',
    format: 'GeoTIFF · ECW (UTM WGS84)',
    desc: 'Distortion-free, color-balanced aerial maps accurate down to individual lane markings and manholes.',
    poster: 'https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?auto=format&fit=crop&w=800&q=80',
    video: 'https://assets.mixkit.co/videos/preview/mixkit-aerial-view-of-a-landscape-with-agricultural-fields-40331-large.mp4'
  },
  {
    title: 'Classified LiDAR Point Cloud',
    format: '.LAS · .LAZ · .E57',
    desc: 'Billions of X,Y,Z points classified into bare earth, vegetation, buildings, and powerlines for cut/fill CAD.',
    poster: 'https://images.unsplash.com/photo-1508614589041-895b88991e3e?auto=format&fit=crop&w=800&q=80',
    video: 'https://assets.mixkit.co/videos/preview/mixkit-aerial-view-of-a-highway-interchange-with-traffic-42784-large.mp4'
  }
];

const workflow = [
  { num: '01', title: 'Geodetic Setup', desc: 'DGCA airspace permits and dual-frequency DGPS control points.' },
  { num: '02', title: 'Autonomous Capture', desc: 'High-overlap RTK/PPK drone flights and terrestrial LiDAR passes.' },
  { num: '03', title: 'Cloud Processing', desc: 'Dense stereo-matching, bare-earth DTM filtering, and 3D meshing.' },
  { num: '04', title: 'CAD/GIS Handover', desc: 'Civil 3D contours, cut/fill reports, and certified QA sign-off.' }
];
---

<Layout title="CRD Infratech — Precision Geomatics & Aerial Intelligence">
  <!-- Transparent wrapper so ThreeGeoBackground from Layout.astro is visible -->
  <div class="relative z-10 text-[#1D1D1F] antialiased">

    <!-- 1. HERO SECTION (Transparent over 3D Terrain) -->
    <section class="min-h-[92vh] flex items-center justify-center pt-24 pb-20 px-5 sm:px-8">
      <div class="max-w-4xl mx-auto text-center space-y-6 bg-white/60 backdrop-blur-md p-8 sm:p-12 rounded-[2.5rem] border border-white/80 shadow-xl shadow-slate-900/5">
        <div class="hero-anim inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-black/[0.08] shadow-sm text-xs font-semibold text-[#1D1D1F]">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          DGCA Certified · Pan-India Geomatics
        </div>

        <h1 class="hero-anim text-4xl sm:text-6xl md:text-7xl font-bold tracking-[-0.035em] text-[#1D1D1F] leading-[1.06]">
          Earth, mapped to <br />
          <span class="bg-gradient-to-r from-[#0066CC] via-[#2563EB] to-[#4F46E5] bg-clip-text text-transparent">
            the millimeter.
          </span>
        </h1>

        <p class="hero-anim text-base sm:text-xl text-[#424245] max-w-2xl mx-auto leading-relaxed">
          CRD Infratech combines aerial LiDAR, RTK DGPS networks, and 3D photogrammetry to turn complex terrain into engineering-ready digital twins.
        </p>

        <div class="hero-anim flex flex-col sm:flex-row items-center justify-center gap-3.5 pt-4">
          <a href="/services" class="w-full sm:w-auto px-7 py-3.5 rounded-full bg-[#0066CC] hover:bg-[#0055B3] text-white font-medium text-sm transition-all shadow-md shadow-[#0066CC]/20">
            Explore Services
          </a>
          <a href="/projects" class="w-full sm:w-auto px-7 py-3.5 rounded-full bg-white hover:bg-slate-50 border border-black/10 text-[#1D1D1F] font-medium text-sm transition-all">
            View Projects &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- 2. APPLE-STYLE BENTO GRID -->
    <section class="py-24 px-5 sm:px-8 bg-white/85 backdrop-blur-md border-t border-black/[0.05]">
      <div class="max-w-7xl mx-auto">
        <div class="mb-14 max-w-2xl reveal-up">
          <p class="text-xs font-semibold uppercase tracking-widest text-[#0066CC] mb-2">Why CRD Infratech</p>
          <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-[#1D1D1F] leading-tight">
            Engineered for scale. <span class="text-[#6E6E73]">Built for absolute accuracy.</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
          <div class="bento-card md:col-span-7 bg-[#F5F5F7] rounded-[2rem] p-8 sm:p-10 flex flex-col justify-between min-h-[280px] border border-black/[0.04]">
            <div>
              <span class="text-xs font-semibold text-[#6E6E73] uppercase tracking-wider">Absolute RMS Accuracy</span>
              <div class="text-6xl sm:text-7xl font-bold tracking-tighter text-[#1D1D1F] mt-3">±1.2<span class="text-[#0066CC]">cm</span></div>
            </div>
            <p class="text-sm sm:text-base text-[#6E6E73] max-w-md mt-6">
              Every aerial flight is tied to dual-frequency DGPS ground control points and validated against Survey of India benchmarks.
            </p>
          </div>

          <div class="bento-card md:col-span-5 bg-[#F5F5F7] rounded-[2rem] p-8 sm:p-10 flex flex-col justify-between min-h-[280px] border border-black/[0.04]">
            <div>
              <span class="text-xs font-semibold text-[#6E6E73] uppercase tracking-wider">Area Mapped</span>
              <div class="text-6xl sm:text-7xl font-bold tracking-tighter text-[#1D1D1F] mt-3">150k<span class="text-[#0066CC]">+</span></div>
              <div class="text-sm font-medium text-[#1D1D1F] mt-1">Hectares across India</div>
            </div>
            <p class="text-sm text-[#6E6E73] mt-6">
              Expressways, railway corridors, solar parks, and open-cast mining reserves.
            </p>
          </div>

          <div class="bento-card md:col-span-4 bg-[#F5F5F7] rounded-[2rem] p-8 flex flex-col justify-between border border-black/[0.04]">
            <span class="text-xs font-semibold text-[#6E6E73] uppercase tracking-wider">Turnaround</span>
            <div class="my-4">
              <div class="text-4xl sm:text-5xl font-bold tracking-tight text-[#1D1D1F]">48 Hrs</div>
              <p class="text-sm text-[#6E6E73] mt-2">Rapid cloud processing for urgent Civil 3D & GIS deliverables.</p>
            </div>
          </div>

          <div class="bento-card md:col-span-8 bg-[#F5F5F7] rounded-[2rem] p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 border border-black/[0.04]">
            <div class="max-w-md">
              <span class="text-xs font-semibold text-[#0066CC] uppercase tracking-wider">Enterprise Fleet</span>
              <h3 class="text-2xl font-bold text-[#1D1D1F] mt-1">DJI Matrice 350 RTK, WingtraOne VTOL & Trimble R12i</h3>
              <p class="text-sm text-[#6E6E73] mt-2">
                1,200+ zero-incident missions executed by DGCA-certified pilots with full-frame photogrammetry and LiDAR payloads.
              </p>
            </div>
            <div class="shrink-0 px-5 py-3 rounded-2xl bg-white border border-black/5 shadow-sm text-center">
              <div class="text-2xl font-bold text-[#1D1D1F]">100%</div>
              <div class="text-[11px] font-medium text-[#6E6E73]">DGCA Compliant</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. FULL SURVEY SPECTRUM -->
    <section id="surveys" class="py-24 px-5 sm:px-8 bg-[#F5F5F7]/90 backdrop-blur-md border-y border-black/[0.05]">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-4 reveal-up">
          <div class="max-w-2xl">
            <p class="text-xs font-semibold uppercase tracking-widest text-[#0066CC] mb-2">Capabilities</p>
            <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-[#1D1D1F]">
              Every survey discipline. <br class="hidden sm:block" />Under one roof.
            </h2>
          </div>
          <a href="/services" class="text-sm font-semibold text-[#0066CC] hover:underline">
            View all services &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {surveyCategories.map((item) => (
            <article class="survey-card group bg-white rounded-[2rem] overflow-hidden border border-black/[0.05] shadow-sm hover:shadow-xl transition-all duration-500 flex flex-col">
              <div class="relative h-56 overflow-hidden bg-slate-100">
                <img
                  src={item.img}
                  alt={item.title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                />
                <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-white/90 backdrop-blur-md text-[11px] font-semibold text-[#1D1D1F] shadow-sm">
                  {item.spec}
                </span>
              </div>
              <div class="p-7 flex-1 flex flex-col justify-between">
                <div>
                  <span class="text-[11px] font-semibold uppercase tracking-wider text-[#0066CC]">{item.category}</span>
                  <h3 class="text-xl font-bold text-[#1D1D1F] mt-1.5 tracking-tight">{item.title}</h3>
                  <p class="text-sm text-[#6E6E73] mt-2.5 leading-relaxed">{item.desc}</p>
                </div>
                <div class="pt-5 mt-5 border-t border-black/[0.06]">
                  <a href="/services" class="text-xs font-semibold text-[#0066CC] hover:underline inline-flex items-center gap-1">
                    Technical specs &rarr;
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. 3D OUTPUTS & VIDEO SHOWCASE -->
    <section id="deliverables" class="py-24 px-5 sm:px-8 bg-white/90 backdrop-blur-md">
      <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16 reveal-up">
          <p class="text-xs font-semibold uppercase tracking-widest text-[#0066CC] mb-2">Deliverables</p>
          <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-[#1D1D1F]">
            Data you can actually build on.
          </h2>
          <p class="text-base text-[#6E6E73] mt-3">
            Clean, georeferenced 3D models and rasters ready for AutoCAD Civil 3D, ArcGIS Pro, Bentley MicroStation, and QGIS.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-7">
          {deliverables.map((d) => (
            <div class="output-card bg-[#F5F5F7] rounded-[2rem] p-3 border border-black/[0.04] flex flex-col">
              <div class="relative h-56 rounded-[1.5rem] overflow-hidden bg-slate-200">
                <video
                  class="w-full h-full object-cover"
                  autoplay
                  loop
                  muted
                  playsinline
                  poster={d.poster}
                >
                  <source src={d.video} type="video/mp4" />
                </video>
                <div class="absolute bottom-3 left-3 px-2.5 py-1 rounded-lg bg-white/90 backdrop-blur-md text-[10px] font-mono font-semibold text-[#1D1D1F]">
                  {d.format}
                </div>
              </div>
              <div class="p-5 flex-1">
                <h3 class="text-lg font-bold text-[#1D1D1F]">{d.title}</h3>
                <p class="text-sm text-[#6E6E73] mt-2 leading-relaxed">{d.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. WORKFLOW -->
    <section id="workflow" class="py-24 px-5 sm:px-8 bg-[#F5F5F7]/90 backdrop-blur-md border-t border-black/[0.05]">
      <div class="max-w-7xl mx-auto">
        <div class="mb-14 reveal-up">
          <p class="text-xs font-semibold uppercase tracking-widest text-[#0066CC] mb-2">Process</p>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#1D1D1F]">From airspace to CAD in four steps.</h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {workflow.map((w) => (
            <div class="workflow-card bg-white rounded-[1.75rem] p-7 border border-black/[0.05]">
              <span class="text-xs font-mono font-bold text-[#0066CC] bg-[#0066CC]/10 px-2.5 py-1 rounded-full">{w.num}</span>
              <h3 class="text-lg font-bold text-[#1D1D1F] mt-5">{w.title}</h3>
              <p class="text-sm text-[#6E6E73] mt-2 leading-relaxed">{w.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. CTA SECTION -->
    <section class="py-24 px-5 sm:px-8 bg-white/90 backdrop-blur-md">
      <div class="max-w-5xl mx-auto bg-[#F5F5F7] rounded-[2.5rem] p-8 sm:p-14 border border-black/[0.06] text-center space-y-6 reveal-up">
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-[#1D1D1F]">
          Ready to map your next site?
        </h2>
        <p class="text-sm sm:text-base text-[#6E6E73] max-w-xl mx-auto">
          Share your KML boundary or project details. Our survey engineers will send a flight plan and quote within 24 hours.
        </p>

        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3.5">
          <a href="/contact" class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-[#0066CC] hover:bg-[#0055B3] text-white font-semibold text-sm transition-all shadow-sm">
            Request a Quote
          </a>
          <a href="/about" class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-white hover:bg-slate-50 border border-black/10 text-[#1D1D1F] font-semibold text-sm transition-all">
            About CRD Infratech
          </a>
        </div>
      </div>
    </section>

  </div>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initGSAP = () => {
    gsap.from('.hero-anim', {
      y: 22,
      opacity: 0,
      duration: 0.8,
      stagger: 0.1,
      ease: 'power3.out',
      clearProps: 'transform,opacity'
    });

    const animateGroup = (selector: string) => {
      document.querySelectorAll(selector).forEach((el) => {
        gsap.from(el, {
          y: 28,
          opacity: 0,
          duration: 0.7,
          ease: 'power3.out',
          immediateRender: false,
          clearProps: 'transform,opacity',
          scrollTrigger: {
            trigger: el,
            start: 'top 90%',
            once: true
          }
        });
      });
    };

    animateGroup('.reveal-up');
    animateGroup('.bento-card');
    animateGroup('.survey-card');
    animateGroup('.output-card');
    animateGroup('.workflow-card');

    ScrollTrigger.refresh();
  };

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initGSAP();
  } else {
    document.addEventListener('DOMContentLoaded', initGSAP);
  }
  window.addEventListener('load', () => ScrollTrigger.refresh());
</script>