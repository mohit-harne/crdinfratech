---
import Layout from '../layouts/Layout.astro';

const surveyCategories = [
  {
    category: 'Aerial Remote Sensing',
    title: 'Drone LiDAR & Photogrammetry',
    desc: 'High-density point clouds penetrating dense vegetation canopy for highway earthwork, solar topography, and open-pit mining volumetrics.',
    spec: 'GSD ≤ 1.2 cm/px',
    code: 'AIR-01',
    img: 'https://images.unsplash.com/photo-1508614589041-895b88991e3e?auto=format&fit=crop&w=900&q=80'
  },
  {
    category: 'Ground Geodesy',
    title: 'DGPS / RTK Control Networks',
    desc: 'Primary geodetic benchmarks tied to Survey of India (SOI) reference datums via high-precision dual-frequency GNSS base-rover networks.',
    spec: '±1.2 cm RMS',
    code: 'GEO-02',
    img: 'https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=900&q=80'
  },
  {
    category: 'Linear Corridors',
    title: 'Highway & Railway Alignment Topo',
    desc: 'Strip plans, long-sections, cross-sections, and alignment verification engineered strictly to NHAI, MoRTH, and IRC standards.',
    spec: 'UAV + Total Station',
    code: 'INF-03',
    img: 'https://images.unsplash.com/photo-1541888946425-d0fbb1861564?auto=format&fit=crop&w=900&q=80'
  },
  {
    category: 'Subsurface Geophysics',
    title: 'Underground Utility Mapping (GPR)',
    desc: 'Ground Penetrating Radar scanning for buried gas lines, fiber optic conduits, water mains, and geological voids prior to piling.',
    spec: 'Up to 6m Depth',
    code: 'SUB-04',
    img: 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=900&q=80'
  },
  {
    category: 'Hydrographic & Marine',
    title: 'Single/Multi-beam River Sounding',
    desc: 'Echo-sounder hydrography integrated with RTK differential corrections for reservoir siltation, river cross-sections, and flood models.',
    spec: 'Sonar + RTK GNSS',
    code: 'HYD-05',
    img: 'https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&w=900&q=80'
  },
  {
    category: 'Structural Geomatics',
    title: '3D Laser SLAM & As-Built BIM',
    desc: 'Millimeter-accurate 3D digital twins of tunnels, bridges, heritage monuments, and structural deflection audits.',
    spec: 'Sub-centimeter BIM',
    code: 'STR-06',
    img: 'https://images.unsplash.com/photo-1590496793929-36417d3117de?auto=format&fit=crop&w=900&q=80'
  }
];

const deliverables = [
  {
    id: 'mesh',
    title: 'Georeferenced 3D Reality Mesh',
    badge: 'Surface Photogrammetry',
    format: '.OBJ · .FBX · Cesium 3D Tiles',
    desc: 'Millimeter-accurate, georeferenced textured surface models allowing project engineers to inspect slopes, haul roads, and clearance envelopes directly in browser 3D viewers.',
    metrics: ['0.015m Volumetric RMS', 'WGS84 / UTM Projected', '100% Surface Coverage'],
    video: 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4',
    poster: 'https://images.unsplash.com/photo-1524661135-423995f22d0b?auto=format&fit=crop&w=900&q=80'
  },
  {
    id: 'ortho',
    title: 'Sub-Centimeter True Orthomosaic',
    badge: 'High-Res Aerial Map',
    format: 'GeoTIFF · ECW · GeoPDF',
    desc: 'Distortion-free, color-calibrated aerial orthophotos aligned to ground coordinates. Enables site engineers to take linear and area measurements down to individual road markings.',
    metrics: ['GSD down to 0.8 cm/px', 'Seamless Radiometric Blend', 'AutoCAD & Civil 3D Ready'],
    video: 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerEscapes.mp4',
    poster: 'https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?auto=format&fit=crop&w=900&q=80'
  },
  {
    id: 'lidar',
    title: 'Classified LiDAR Point Clouds',
    badge: 'Bare-Earth Topo & Contours',
    format: '.LAS · .LAZ · .E57',
    desc: 'Billions of discrete laser return pulses split into ASPRS classifications (Ground, Low/High Veg, Structures). Eliminates dense canopy for accurate cut/fill calculations.',
    metrics: ['16+ Laser Returns/m²', 'Canopy Penetration', 'Civil 3D Surface Ready'],
    video: 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/WeAreGoingOnBullrun.mp4',
    poster: 'https://images.unsplash.com/photo-1508614589041-895b88991e3e?auto=format&fit=crop&w=900&q=80'
  }
];

const workflow = [
  { step: '01', title: 'Geodetic Baseline & Permits', desc: 'DGCA airspace clearances, flight path authorization, and dual-frequency DGPS ground control point (GCP) layout.' },
  { step: '02', title: 'Autonomous LiDAR & UAV Flight', desc: 'Automated high-overlap (80/75%) RTK/PPK drone flights, aerial LiDAR sweeps, and terrestrial total station validation.' },
  { step: '03', title: 'Cloud Photogrammetry Processing', desc: 'Kinematic trajectory corrections, dense point cloud generation, automated vegetation removal, and DTM generation.' },
  { step: '04', title: 'Engineering CAD & QA Delivery', desc: 'Civil 3D contours, cut/fill surface comparisons, stockpile volume balance reports, and signed surveyor sign-off.' }
];

const platformMetrics = [
  { label: 'Absolute RMS Accuracy', val: '1.2', unit: 'cm', prefix: '±', sub: 'Tied to Survey of India geodetic datums' },
  { label: 'Area Mapped Across India', val: '150', unit: 'k+', prefix: '', sub: 'Highways, solar parks & mining blocks' },
  { label: 'CAD Delivery Turnaround', val: '48', unit: 'hrs', prefix: '', sub: 'Cloud processing with surveyor QA/QC' },
  { label: 'DGCA Flight Compliance', val: '100', unit: '%', prefix: '', sub: '1,200+ zero-incident commercial sorties' }
];
---

<Layout title="CRD Infratech — Precision Drone Surveying, LiDAR & Worksite Intelligence">
  <div class="relative z-10 bg-[#FAFAFC] text-[#0F172A] antialiased selection:bg-[#0284C7] selection:text-white">

    <!-- 1. HERO SECTION -->
    <section class="relative min-h-[92vh] flex items-center justify-center pt-28 pb-20 px-5 sm:px-8 overflow-hidden">
      <!-- Light Engineering Grid Background -->
      <div class="absolute inset-0 bg-[radial-gradient(#E2E8F0_1px,transparent_1px)] [background-size:28px_28px] opacity-70 pointer-events-none"></div>
      
      <!-- Cyan/Blue Soft Backlight Glow -->
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-gradient-to-tr from-[#0284C7]/10 via-[#0EA5E9]/10 to-indigo-500/10 blur-[120px] rounded-full pointer-events-none"></div>

      <div class="max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10">
        
        <!-- Left: Copy & Actions -->
        <div class="lg:col-span-7 space-y-7">
          <div class="hero-anim inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white border border-slate-200 shadow-xs text-xs font-semibold text-slate-800">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-slate-500 font-mono">DGCA CERTIFIED</span>
            <span class="text-slate-300">|</span>
            <span>Drone LiDAR & Aerial Intelligence</span>
          </div>

          <h1 class="hero-anim text-4xl sm:text-6xl xl:text-7xl font-extrabold tracking-[-0.03em] text-[#0F172A] leading-[1.08]">
            Worksite drone data, <br />
            <span class="bg-gradient-to-r from-[#0284C7] via-[#0284C7] to-[#0369A1] bg-clip-text text-transparent">
              mapped to the millimeter.
            </span>
          </h1>

          <p class="hero-anim text-base sm:text-lg text-slate-600 max-w-xl leading-relaxed">
            CRD Infratech combines aerial LiDAR, RTK DGPS geodetic control, and cloud-based 3D digital twins to turn raw site topography into verifiable engineering deliverables.
          </p>

          <div class="hero-anim flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
            <a 
              href="/contact" 
              class="px-8 py-3.5 rounded-xl bg-[#0284C7] hover:bg-[#0369A1] text-white font-semibold text-sm transition-all shadow-md shadow-[#0284C7]/20 flex items-center justify-center gap-2 group cursor-pointer"
            >
              <span>Request Platform Demo</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
            <a 
              href="/services" 
              class="px-7 py-3.5 rounded-xl bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 font-semibold text-sm transition-all shadow-xs flex items-center justify-center"
            >
              Explore Survey Services
            </a>
          </div>

          <!-- Technical Spec Badges -->
          <div class="hero-anim pt-6 flex flex-wrap items-center gap-6 sm:gap-8 border-t border-slate-200/80 text-xs font-mono text-slate-500">
            <div><strong class="text-slate-900 font-bold">±12mm</strong> ABSOLUTE RMS</div>
            <div class="w-1.5 h-1.5 bg-slate-300 rounded-full"></div>
            <div><strong class="text-slate-900 font-bold">0.8 cm/px</strong> TRUE GSD</div>
            <div class="w-1.5 h-1.5 bg-slate-300 rounded-full"></div>
            <div><strong class="text-slate-900 font-bold">WGS84 / UTM</strong> BENCHMARKS</div>
          </div>
        </div>

        <!-- Right: Propeller-Style 3D Site HUD Simulator -->
        <div class="hero-anim lg:col-span-5">
          <div class="relative rounded-2xl border border-slate-200/90 bg-white shadow-xl shadow-slate-900/6 overflow-hidden">
            <!-- Simulated Top Bar -->
            <div class="px-4 py-3 bg-slate-50/90 border-b border-slate-200/80 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                <span class="text-xs font-mono font-bold text-slate-700 tracking-tight">SURVEY_3D_VIEWER // HIGHWAY_CORRIDOR_04</span>
              </div>
              <span class="text-[11px] font-mono text-[#0284C7] bg-[#0284C7]/10 px-2 py-0.5 rounded font-semibold border border-[#0284C7]/20">
                RTK FIXED
              </span>
            </div>

            <!-- Viewport with Video Surface -->
            <div class="relative aspect-4/3 w-full bg-slate-950 overflow-hidden">
              <video
                class="w-full h-full object-cover"
                autoplay
                loop
                muted
                playsinline
                poster="https://images.unsplash.com/photo-1541888946425-d0fbb1861564?auto=format&fit=crop&w=1000&q=80"
              >
                <source src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4" type="video/mp4" />
              </video>

              <!-- Subtle Elevation Contour Heatmap Overlay -->
              <div class="absolute inset-0 bg-gradient-to-tr from-[#0284C7]/15 via-transparent to-amber-500/10 pointer-events-none"></div>

              <!-- Real-time HUD Measurement Box -->
              <div class="absolute top-4 left-4 p-3 rounded-xl bg-white/95 backdrop-blur-md border border-slate-200/80 shadow-md text-xs font-mono text-slate-700 space-y-1">
                <div class="text-[10px] uppercase font-bold text-slate-400">VOLUMETRIC CUT / FILL</div>
                <div class="text-emerald-600 font-bold">CUT: +18,450 m³</div>
                <div class="text-rose-600 font-bold">FILL: -4,120 m³</div>
                <div class="text-[10px] text-slate-500 pt-1 border-t border-slate-100 font-semibold">NET: +14,330 m³</div>
              </div>

              <!-- Coordinate Telemetry HUD -->
              <div class="absolute bottom-4 right-4 px-3 py-1.5 rounded-lg bg-white/95 backdrop-blur-md border border-slate-200/80 shadow-xs text-[11px] font-mono text-slate-700 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-[#0284C7] animate-ping"></span>
                <span>21.1458° N, 79.0882° E</span>
              </div>
            </div>

            <!-- Bottom Telemetry HUD Bar -->
            <div class="p-3 bg-slate-50/90 border-t border-slate-200/80 grid grid-cols-3 gap-2 text-center text-xs">
              <div class="p-2 rounded-lg bg-white border border-slate-200/70 shadow-2xs">
                <div class="text-slate-400 text-[10px] font-mono font-medium">POINT CLOUD</div>
                <div class="font-bold text-slate-900 mt-0.5">38.4M Pts</div>
              </div>
              <div class="p-2 rounded-lg bg-white border border-slate-200/70 shadow-2xs">
                <div class="text-slate-400 text-[10px] font-mono font-medium">CONTOUR INT.</div>
                <div class="font-bold text-slate-900 mt-0.5">0.20 m</div>
              </div>
              <div class="p-2 rounded-lg bg-white border border-slate-200/70 shadow-2xs">
                <div class="text-slate-400 text-[10px] font-mono font-medium">TOLERANCE</div>
                <div class="font-bold text-[#0284C7] mt-0.5">± 0.012 m</div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- 2. TELEMETRY & METRICS -->
    <section class="py-20 px-5 sm:px-8 bg-white border-y border-slate-200/80">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {platformMetrics.map((item) => (
            <div class="metric-card p-8 rounded-2xl bg-[#F8FAFC] border border-slate-200/80 flex flex-col justify-between hover:border-[#0284C7]/40 hover:shadow-md transition-all">
              <span class="text-xs font-mono font-semibold uppercase tracking-wider text-[#0284C7]">{item.label}</span>
              <div class="my-5">
                <div class="text-5xl font-extrabold text-[#0F172A] font-mono tracking-tight flex items-baseline">
                  {item.prefix && <span>{item.prefix}</span>}
                  <span class="counter" data-target={item.val}>0</span>
                  <span class="text-[#0284C7] text-3xl ml-1">{item.unit}</span>
                </div>
              </div>
              <p class="text-xs text-slate-500 leading-relaxed">{item.sub}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. INTERACTIVE DELIVERABLES (Propeller Aero Style Tab Switcher) -->
    <section id="deliverables" class="py-24 px-5 sm:px-8 bg-[#FAFAFC] border-b border-slate-200/80">
      <div class="max-w-7xl mx-auto space-y-14">
        
        <div class="max-w-3xl space-y-3 reveal-up">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0284C7]/10 text-xs font-mono font-bold text-[#0284C7] border border-[#0284C7]/20">
            ENGINEERING DELIVERABLES
          </div>
          <h2 class="text-3xl sm:text-5xl font-extrabold text-[#0F172A] tracking-tight">
            Data you can actually design and build on.
          </h2>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            Eliminate communication gaps between site crews and CAD designers. All aerial captures export directly into AutoCAD Civil 3D, ArcGIS Pro, Bentley MicroStation, and QGIS.
          </p>
        </div>

        <!-- Interactive Tabbed Switcher -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
          
          <!-- Left: Tab Controls -->
          <div class="lg:col-span-5 flex flex-col justify-between gap-4">
            {deliverables.map((item, index) => (
              <div 
                class={`deliverable-tab cursor-pointer p-6 rounded-2xl border transition-all duration-300 ${index === 0 ? 'bg-white border-[#0284C7] shadow-lg shadow-[#0284C7]/10 ring-1 ring-[#0284C7]' : 'bg-white/60 border-slate-200 hover:border-slate-300'}`}
                data-target={item.id}
              >
                <div class="flex items-center justify-between mb-2">
                  <span class="text-xs font-mono font-bold text-[#0284C7] uppercase">{item.badge}</span>
                  <span class="text-[11px] font-mono text-slate-500 bg-slate-100 px-2 py-0.5 rounded font-medium">{item.format}</span>
                </div>
                <h3 class="text-xl font-bold text-[#0F172A]">{item.title}</h3>
                <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">{item.desc}</p>
                
                <div class="mt-4 pt-3 border-t border-slate-100 flex flex-wrap gap-2">
                  {item.metrics.map((m) => (
                    <span class="text-[10px] font-mono bg-slate-50 text-slate-700 px-2 py-1 rounded border border-slate-200/80 font-medium">
                      ✓ {m}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <!-- Right: Video Frame with Crossfade Controls -->
          <div class="lg:col-span-7 rounded-2xl bg-white border border-slate-200 p-2 sm:p-3 flex flex-col justify-between overflow-hidden relative shadow-lg min-h-[440px]">
            <div class="relative w-full h-full rounded-xl overflow-hidden bg-slate-900">
              {deliverables.map((item, idx) => (
                <div 
                  class={`deliverable-preview absolute inset-0 w-full h-full transition-opacity duration-500 ${idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`} 
                  id={`preview-${item.id}`}
                >
                  <video 
                    class="w-full h-full object-cover" 
                    autoplay 
                    loop 
                    muted 
                    playsinline
                    poster={item.poster}
                  >
                    <source src={item.video} type="video/mp4" />
                  </video>
                  <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
                  
                  <div class="absolute bottom-5 left-5 right-5 flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
                    <div class="bg-white/95 backdrop-blur-md px-3.5 py-1.5 rounded-lg border border-slate-200/80 font-semibold text-slate-900 shadow-xs">
                      FORMAT: {item.format}
                    </div>
                    <div class="bg-[#0284C7]/90 text-white backdrop-blur-md px-3.5 py-1.5 rounded-lg font-semibold shadow-xs">
                      SURVEY OF INDIA VALIDATED
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- 4. CAPABILITIES CATALOG (Light Industrial Cards) -->
    <section id="services" class="py-24 px-5 sm:px-8 bg-white border-b border-slate-200/80">
      <div class="max-w-7xl mx-auto space-y-14">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 reveal-up">
          <div class="max-w-2xl space-y-2">
            <span class="text-xs font-mono uppercase tracking-widest text-[#0284C7] font-bold">Capabilities</span>
            <h2 class="text-3xl sm:text-5xl font-extrabold text-[#0F172A] tracking-tight">
              Every survey discipline. Handled in-house.
            </h2>
            <p class="text-slate-600 text-sm sm:text-base">
              From high-altitude LiDAR passes to subsurface geophysical radargrams, CRD Infratech equips your engineering projects with end-to-end spatial certainty.
            </p>
          </div>
          <a href="/services" class="inline-flex items-center gap-2 text-sm font-semibold text-[#0284C7] hover:underline underline-offset-4">
            View Technical Specs &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {surveyCategories.map((item) => (
            <article class="service-card group rounded-2xl bg-[#F8FAFC] border border-slate-200/80 overflow-hidden hover:border-[#0284C7] hover:shadow-xl hover:shadow-slate-900/5 transition-all duration-300 flex flex-col justify-between">
              <div>
                <div class="relative h-56 overflow-hidden bg-slate-100">
                  <img
                    src={item.img}
                    alt={item.title}
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/40 via-transparent to-transparent"></div>
                  
                  <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-white/95 backdrop-blur-md text-[11px] font-mono font-bold text-slate-800 shadow-xs">
                    {item.spec}
                  </span>

                  <span class="absolute top-4 right-4 text-xs font-mono font-semibold text-white bg-black/60 px-2 py-0.5 rounded backdrop-blur-md">
                    {item.code}
                  </span>
                </div>

                <div class="p-7 space-y-3">
                  <div class="text-[11px] font-mono font-bold text-[#0284C7] uppercase tracking-wider">{item.category}</div>
                  <h3 class="text-xl font-bold text-[#0F172A] tracking-tight group-hover:text-[#0284C7] transition-colors">{item.title}</h3>
                  <p class="text-sm text-slate-600 leading-relaxed">{item.desc}</p>
                </div>
              </div>

              <div class="px-7 py-4 border-t border-slate-200/80 bg-white/50 flex items-center justify-between text-xs font-mono">
                <span class="text-slate-500">DGCA Compliant</span>
                <a href="/services" class="font-bold text-[#0284C7] hover:underline inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                  Detailed Specs &rarr;
                </a>
              </div>
            </article>
          ))}
        </div>

      </div>
    </section>

    <!-- 5. WORKFLOW (Sequential Engineering Flow) -->
    <section class="py-24 px-5 sm:px-8 bg-[#FAFAFC] border-b border-slate-200/80">
      <div class="max-w-7xl mx-auto space-y-14">
        
        <div class="text-center max-w-3xl mx-auto space-y-3 reveal-up">
          <span class="text-xs font-mono font-bold text-[#0284C7] uppercase tracking-wider">Process Pipeline</span>
          <h2 class="text-3xl sm:text-5xl font-extrabold text-[#0F172A] tracking-tight">From Airspace to CAD in Four Steps</h2>
          <p class="text-slate-600 text-sm sm:text-base">Systematic data collection, geodetic verification, and automated cloud computing.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {workflow.map((w) => (
            <div class="workflow-card p-7 rounded-2xl bg-white border border-slate-200/80 shadow-xs flex flex-col justify-between hover:shadow-md transition-all">
              <div>
                <span class="text-3xl font-mono font-black text-slate-300">{w.step}</span>
                <h3 class="text-lg font-bold text-[#0F172A] mt-4">{w.title}</h3>
                <p class="text-xs sm:text-sm text-slate-600 mt-2.5 leading-relaxed">{w.desc}</p>
              </div>
              <div class="mt-6 pt-4 border-t border-slate-100 flex items-center gap-2 text-[11px] font-mono text-[#0284C7] font-semibold">
                <span class="w-1.5 h-1.5 rounded-full bg-[#0284C7]"></span>
                STAGE QA CERTIFIED
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- 6. CALL TO ACTION -->
    <section class="py-24 px-5 sm:px-8 bg-white">
      <div class="max-w-5xl mx-auto rounded-3xl p-10 sm:p-16 border border-slate-200 bg-[#F8FAFC] text-center space-y-7 shadow-xs reveal-up">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-slate-200 text-xs font-mono text-[#0284C7] font-bold shadow-2xs">
          READY FOR FLIGHT PLANNING
        </div>

        <h2 class="text-3xl sm:text-5xl font-extrabold text-[#0F172A] tracking-tight">
          Ready to map your next worksite?
        </h2>

        <p class="text-slate-600 text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
          Upload your KML/KMZ project boundary or request an on-site survey team. Our geodesy engineers calculate flight lines and dispatch formal proposals within 24 hours.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 pt-2">
          <a href="/contact" class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-[#0284C7] hover:bg-[#0369A1] text-white font-semibold text-sm transition-all shadow-md shadow-[#0284C7]/20">
            Submit KML / Request Quote
          </a>
          <a href="/projects" class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-white hover:bg-slate-50 border border-slate-200 text-slate-800 font-semibold text-sm transition-all shadow-2xs">
            Explore Project Case Studies &rarr;
          </a>
        </div>
      </div>
    </section>

  </div>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initAnimations = () => {
    // 1. Hero Content Staggered Entrance
    gsap.from('.hero-anim', {
      y: 28,
      opacity: 0,
      duration: 0.9,
      stagger: 0.1,
      ease: 'power3.out',
      clearProps: 'transform,opacity'
    });

    // 2. Numerical Telemetry Counters
    const counters = document.querySelectorAll('.counter');
    counters.forEach((counter) => {
      const target = parseFloat(counter.getAttribute('data-target') || '0');
      const isDecimal = target % 1 !== 0;

      ScrollTrigger.create({
        trigger: counter,
        start: 'top 85%',
        once: true,
        onEnter: () => {
          gsap.to(counter, {
            innerHTML: target,
            duration: 1.8,
            ease: 'power2.out',
            snap: { innerHTML: isDecimal ? 0.1 : 1 },
            onUpdate: function () {
              if (isDecimal) {
                counter.innerHTML = Number(counter.innerHTML).toFixed(1);
              }
            }
          });
        }
      });
    });

    // 3. Staggered ScrollTrigger Card Reveals
    const animateSection = (selector: string) => {
      const elements = document.querySelectorAll(selector);
      if (!elements.length) return;

      gsap.from(elements, {
        y: 30,
        opacity: 0,
        duration: 0.8,
        stagger: 0.12,
        ease: 'power3.out',
        clearProps: 'transform,opacity',
        scrollTrigger: {
          trigger: elements[0],
          start: 'top 88%',
          once: true
        }
      });
    };

    animateSection('.reveal-up');
    animateSection('.metric-card');
    animateSection('.service-card');
    animateSection('.workflow-card');

    // 4. Interactive Deliverables Tab Switching Logic
    const tabs = document.querySelectorAll('.deliverable-tab');
    const previews = document.querySelectorAll('.deliverable-preview');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-target');

        tabs.forEach((t) => {
          t.classList.remove('bg-white', 'border-[#0284C7]', 'shadow-lg', 'shadow-[#0284C7]/10', 'ring-1', 'ring-[#0284C7]');
          t.classList.add('bg-white/60', 'border-slate-200');
        });

        tab.classList.remove('bg-white/60', 'border-slate-200');
        tab.classList.add('bg-white', 'border-[#0284C7]', 'shadow-lg', 'shadow-[#0284C7]/10', 'ring-1', 'ring-[#0284C7]');

        previews.forEach((prev) => {
          if (prev.id === `preview-${targetId}`) {
            gsap.to(prev, { opacity: 1, duration: 0.45, zIndex: 10 });
            const vid = prev.querySelector('video');
            if (vid) vid.play();
          } else {
            gsap.to(prev, { opacity: 0, duration: 0.45, zIndex: 0 });
          }
        });
      });
    });

    ScrollTrigger.refresh();
  };

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initAnimations();
  } else {
    document.addEventListener('DOMContentLoaded', initAnimations);
  }
  window.addEventListener('load', () => ScrollTrigger.refresh());
</script>